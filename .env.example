# Semua variabel di bawah opsional. Tanpa database, situs & semua endpoint tetap
# berjalan; hanya statistik pemakaian dan pemendek URL bawaan (/api/tools/shorturl)
# yang nonaktif. Pilih SALAH SATU dari dua cara berikut.

# Cara 1 (disarankan untuk Vercel/Netlify): Supabase lewat REST.
# Jalankan supabase/schema.sql sekali di SQL Editor, lalu isi URL proyek dan
# service role / secret key (Project Settings > API Keys). Jangan pakai anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cara 2: connection string PostgreSQL (Neon, Vercel Postgres, Supabase pooler, dll.).
# Tabel dibuat otomatis saat pertama kali dipakai.
DATABASE_URL=

# Opsional. Domain produksi untuk canonical URL, sitemap, dan gambar Open Graph.
# Di Vercel tidak wajib (otomatis memakai domain produksi proyek).
NEXT_PUBLIC_SITE_URL=

# --- Batas pemakaian & blokir IP -------------------------------------------------
# Kunci rahasia owner untuk mengelola blokir IP. Wajib diisi agar endpoint admin aktif:
#   /api/admin/bans?key=...            daftar IP yang diblokir
#   /api/admin/unban?ip=1.2.3.4&key=... buka blokir
#   /api/admin/ban?ip=1.2.3.4&key=...   blokir manual
# Gunakan string acak yang panjang dan jangan dibagikan.
ADMIN_KEY=

# Opsional. Batas permintaan per menit untuk setiap IP (default 45).
RATE_LIMIT_PER_MIN=
# Opsional. Jumlah pelanggaran dalam 10 menit sebelum IP diblokir permanen (default 3).
BAN_AFTER_STRIKES=
# Opsional. Nomor WhatsApp owner untuk banding blokir (default 62895403334081).
OWNER_WHATSAPP=

# --- Server perantara Sankanime (kategori Film / sanka-*) --------------------------
# API Sankanime menolak IP server hosting, jadi dipanggil lewat Supabase Edge Function.
# Deploy supabase/functions/film-proxy (tanpa verifikasi JWT), isi secret FILM_PROXY_KEY
# di Supabase, lalu tulis alamat fungsi dan kunci yang sama di sini.
# Dibiarkan kosong: endpoint /api/film/sanka-* menjawab 503.
# Contoh: https://<ref>.supabase.co/functions/v1/film-proxy
SANKA_PROXY_URL=
SANKA_PROXY_KEY=

# --- Server perantara LK21 (kategori Film / lk21-*) --------------------------------
# LK21 menolak IP server hosting, jadi endpoint /api/film/lk21-* dititipkan lewat VPS sendiri.
# Pasang dengan scripts/film-proxy/install.sh di VPS, lalu salin PROXY_URL dan PROXY_KEY
# yang dicetaknya ke sini. Dibiarkan kosong: endpoint lk21-* menjawab 503.
FILM_PROXY_URL=
FILM_PROXY_KEY=

# --- Web ke APK (/api/tools/web2apk) -------------------------------------------------
# Kunci API dari akunmu sendiri di layanan pembuat APK (menu API Builder di rfweb2apk.rfdevv.com).
# Akun gratis mendapat 3 build per hari; paket berbayar lebih banyak.
# Dibiarkan kosong: endpoint berjalan sebagai tamu, yang hanya mendapat 1 build per hari
# per alamat IP server, lalu menjawab 429.
WEB2APK_API_KEY=

# --- Gambar ke URL (/api/tools/tourl) ---------------------------------------------------
# Gambar unggahan disimpan di Supabase Storage, jadi fitur ini butuh SUPABASE_URL dan
# SUPABASE_SERVICE_ROLE_KEY di atas (DATABASE_URL saja tidak cukup). Bucket dibuat otomatis
# saat unggahan pertama. Tanpa Supabase endpoint ini menjawab 503.
# Opsional. Berapa hari gambar disimpan sebelum dihapus otomatis (default 30). Isi 0 untuk
# menyimpan selamanya; ingat kuota Storage paket gratis Supabase hanya 1 GB.
IMAGE_TTL_DAYS=
# Opsional. Nama bucket (default yanz-images).
IMAGE_BUCKET=

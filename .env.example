# Semua variabel di bawah opsional. Tanpa database, situs & semua endpoint tetap
# berjalan; hanya statistik pemakaian dan pemendek URL bawaan (/api/tools/shorturl)
# yang nonaktif. Pilih SALAH SATU dari dua cara berikut.

# Cara 1 (disarankan untuk Vercel/Netlify): Supabase lewat REST.
# Jalankan supabase/schema.sql sekali di SQL Editor, lalu isi URL proyek dan
# service role / secret key (Project Settings > API Keys). Jangan pakai anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cara 2: connection string PostgreSQL (Neon, Vercel Postgres, Supabase pooler, dll.).
# Tabel dibuat otomatis saat pertama kali dipakai.
DATABASE_URL=

# Opsional. Domain produksi untuk canonical URL, sitemap, dan gambar Open Graph.
# Di Vercel tidak wajib (otomatis memakai domain produksi proyek).
NEXT_PUBLIC_SITE_URL=

# --- Batas pemakaian & blokir IP -------------------------------------------------
# Kunci rahasia owner untuk mengelola blokir IP. Wajib diisi agar endpoint admin aktif:
#   /api/admin/bans?key=...            daftar IP yang diblokir
#   /api/admin/unban?ip=1.2.3.4&key=... buka blokir
#   /api/admin/ban?ip=1.2.3.4&key=...   blokir manual
# Gunakan string acak yang panjang dan jangan dibagikan.
ADMIN_KEY=

# Opsional. Batas permintaan per menit untuk setiap IP (default 45).
RATE_LIMIT_PER_MIN=
# Opsional. Jumlah pelanggaran dalam 10 menit sebelum IP diblokir permanen (default 3).
BAN_AFTER_STRIKES=
# Opsional. Nomor WhatsApp owner untuk banding blokir (default 62895403334081).
OWNER_WHATSAPP=
